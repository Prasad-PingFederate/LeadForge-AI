# ── DATABASE & CACHE ─────────────────────────────────────────────────────────
# For local lightweight dev/test without Docker:
DATABASE_URL=sqlite+aiosqlite:///./leadforge.db
# For production / Docker Compose PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://leadforge:leadforge_pass@postgres:5432/leadforge_db

REDIS_URL=redis://localhost:6379/0
# In docker compose:
# REDIS_URL=redis://redis:6379/0

# ── LLM PROVIDERS (PROVIDER-AGNOSTIC) ─────────────────────────────────────────
# Select default provider: "openai" | "anthropic" | "gemini" | "mock"
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── SEARCH & INTENT CONNECTORS (WITH GRACEFUL FALLBACKS) ──────────────────────
# Serper.dev API key for Google Search dorks & B2B company discovery
SERPER_API_KEY=
# Tavily API key for deep competitor research (optional)
TAVILY_API_KEY=
# Brave Search API key (optional)
BRAVE_API_KEY=

# ── WATERFALL EMAIL ENRICHMENT & VERIFICATION ─────────────────────────────────
# Hunter.io API key (optional)
HUNTER_API_KEY=
# Apollo.io API key (optional)
APOLLO_API_KEY=
# ZeroBounce / MillionVerifier API key (optional)
MILLION_VERIFIER_API_KEY=

# ── EMAIL DELIVERABILITY & COMPLIANCE ─────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=outreach@leadforge.ai
UNSUBSCRIBE_BASE_URL=http://localhost:8000/api/unsubscribe

# Daily sending limits per inbox
DAILY_SEND_CAP=50
MIN_INTERVAL_SECONDS=45
MAX_INTERVAL_SECONDS=180

# ── SERVER CONFIG ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
